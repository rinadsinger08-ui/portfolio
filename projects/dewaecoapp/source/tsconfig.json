{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "noEmit": true, "esModuleInterop": true, "skipLibCheck": true,
    "strict": true, "noUnusedLocals": false
  },
  "include": ["./*.tsx", "./*.ts", "utils/**/*.ts"]
}
